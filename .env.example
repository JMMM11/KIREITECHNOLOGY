# Copia este archivo como .env.local y llena los valores (Firebase > Configuración del proyecto > Tus apps).
# Son datos públicos de la web; la seguridad está en firestore.rules. Nunca pongas aquí claves secretas.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# true para usar los emuladores locales de Firestore y Auth en vez de la base real.
VITE_FIREBASE_EMULADOR=false
# Sentry (monitoreo de errores). Vacío = apagado. El DSN es público por diseño; nunca pongas aquí el token de autenticación.
VITE_SENTRY_DSN=
# development, staging o production. Vacío = el modo de Vite.
VITE_SENTRY_ENTORNO=
# Fracción de visitas con medición de rendimiento (0 a 1).
VITE_SENTRY_TRAZAS=0.1
# true = grabar repetición de las sesiones con error (todo el texto y las imágenes salen ocultos). Revisa la política de privacidad antes.
VITE_SENTRY_REPLAY=false
