# Copia este archivo como .env.local y llena los valores. .env.local no se sube al repo.
# Firebase > Configuración del proyecto > Tus apps > Web (son públicos, no secretos).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary: nombre de la nube y un upload preset en modo "Unsigned".
# La API secret de Cloudinary NUNCA va aquí ni en ningún archivo del frontend.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
